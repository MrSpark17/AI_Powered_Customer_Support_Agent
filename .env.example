# Copy to .env for local development. Never commit real credentials.

# Required for draft generation and optional moderation guardrails.
OPENAI_API_KEY=

# Optional: LangSmith observability. Tracing is disabled until both values are set.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=support-copilot
# Use the endpoint matching your LangSmith region. The value below is US cloud.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required only for API keys that are associated with multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Optional: OpenAI moderation guardrails. A failed moderation request is held
# for human review by default (fail closed).
GUARDRAILS_ENABLED=true
GUARDRAILS_FAIL_OPEN=false
GUARDRAIL_MODERATION_MODEL=omni-moderation-latest
GUARDRAIL_REQUEST_TIMEOUT_SECONDS=10
